# Port for the standalone chess clock microservice
PORT=4000

# Secret for verifying JWT tokens between Next.js and the Clock service
CLOCK_SERVER_SECRET=dev-secret-clock-key-123

# Mumbai Database / Core Web App endpoint for async background synchronization
# e.g., http://localhost:3000 in development, https://api.zextaos.com in production
MUMBAI_SYNC_URL=http://localhost:3000
